FROM node:22-alpine AS build

WORKDIR /app

ARG API_URL=http://api:8000
ARG NEXT_PUBLIC_API_URL=https://api.sentimenta.com.br/api/v1
ARG NEXT_PUBLIC_GOOGLE_TAG_ID=
ARG NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_CONVERSION_LABEL=
ARG NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION_LABEL=

ENV NEXT_TELEMETRY_DISABLED=1 \
    API_URL=${API_URL} \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_GOOGLE_TAG_ID=${NEXT_PUBLIC_GOOGLE_TAG_ID} \
    NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_CONVERSION_LABEL=${NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_CONVERSION_LABEL} \
    NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION_LABEL=${NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION_LABEL}

COPY package.json package-lock.json turbo.json ./
COPY packages/types/package.json packages/types/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY frontend/package.json frontend/package.json
COPY apps/mobile/package.json apps/mobile/package.json

RUN npm ci

COPY packages/ packages/
COPY frontend/ frontend/

RUN npm run build:packages && npm run build:web && npm prune --omit=dev

FROM node:22-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

RUN addgroup -S nodejs && adduser -S nextjs -G nodejs

COPY --from=build --chown=nextjs:nodejs /app/package.json /app/package-lock.json ./
COPY --from=build --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=build --chown=nextjs:nodejs /app/packages ./packages
COPY --from=build --chown=nextjs:nodejs /app/frontend/package.json ./frontend/package.json
COPY --from=build --chown=nextjs:nodejs /app/frontend/next.config.js ./frontend/next.config.js
COPY --from=build --chown=nextjs:nodejs /app/frontend/i18n ./frontend/i18n
COPY --from=build --chown=nextjs:nodejs /app/frontend/messages ./frontend/messages
COPY --from=build --chown=nextjs:nodejs /app/frontend/public ./frontend/public
COPY --from=build --chown=nextjs:nodejs /app/frontend/.next ./frontend/.next

USER nextjs

EXPOSE 3000

CMD ["npm", "run", "start", "--workspace=frontend", "--", "--hostname", "0.0.0.0", "--port", "3000"]
