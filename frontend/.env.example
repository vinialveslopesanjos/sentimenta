# API Backend URL (usado no client-side)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# API Backend URL (usado no server-side, ex: rewrites do Next.js)
# Em produção na Vercel, apontar para o backend real (ex: https://api.sentimenta.com.br)
API_URL=http://127.0.0.1:8000

# Google OAuth (obtenha em: https://console.cloud.google.com/apis/credentials)
# 1. Crie um projeto
# 2. Ative "Google+ API"
# 3. Crie credenciais OAuth 2.0 Web Client
# 4. Authorized JavaScript origins: http://localhost:3000
# 5. Copie o Client ID abaixo
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
