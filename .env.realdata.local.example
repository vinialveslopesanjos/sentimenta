# Copy to .env.realdata.local. The copied file is ignored by Git.
# This mode is for local development using a restored production snapshot.
# Never put production write credentials here.

DEBUG=true
READ_ONLY_MODE=true

# Local PostgreSQL restored from a production snapshot.
# Keep this host local unless you explicitly know you are using a read-only replica.
DATABASE_URL=postgresql://sentimenta_local:sentimenta_local@127.0.0.1:5432/sentimenta_realdata_local

# Local auth/cookie values. Replace in your private .env.realdata.local if needed.
SECRET_KEY=local-realdata-dev-secret-change-me
TOKEN_ENCRYPTION_KEY=local-realdata-token-key-change-me-32
SESSION_COOKIE_SECURE=false
APP_URL=http://127.0.0.1:3000
FRONTEND_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

# Disable local Redis dependency unless you intentionally run Redis locally.
REDIS_URL=
CACHE_REDIS_URL=
RATE_LIMIT_REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Keep external integrations empty in snapshot mode.
APIFY_API_TOKEN=
OPENROUTER_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
POSTHOG_API_KEY=
SENTRY_DSN=
