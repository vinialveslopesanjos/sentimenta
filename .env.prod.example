# Copy to .env on the VPS and fill the real values there.
# Never commit the real .env.

POSTGRES_USER=sentimenta
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentimenta_db
REDIS_PASSWORD=change-me
CACHE_REDIS_URL=redis://:change-me@redis:6379/2
RATE_LIMIT_REDIS_URL=redis://:change-me@redis:6379/3

SECRET_KEY=change-me
TOKEN_ENCRYPTION_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

APP_URL=https://sentimenta.com.br
NEXT_PUBLIC_API_URL=https://api.sentimenta.com.br/api/v1
CORS_ORIGINS=https://sentimenta.com.br,https://www.sentimenta.com.br

# Google Ads conversion tracking.
# NEXT_PUBLIC_GOOGLE_TAG_ID example: AW-123456789
# NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_CONVERSION_LABEL is the label from the "cadastro completo" conversion action.
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_CONVERSION_LABEL=

DEBUG=false
SENTRY_DSN=

LLM_MODEL=google/gemini-2.5-flash
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
GEMINI_API_KEY=
APIFY_API_TOKEN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

RESEND_API_KEY=
FROM_EMAIL=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://api.sentimenta.com.br/api/v1/connections/instagram/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.sentimenta.com.br/api/v1/connections/tiktok/callback
